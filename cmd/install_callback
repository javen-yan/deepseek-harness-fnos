#!/bin/bash
set -e

export PATH="/var/apps/nodejs_v24/target/bin:$PATH"

APP_DIR="$TRIM_APPDEST"
DATA_DIR="$TRIM_PKGVAR"
TMP_DIR="$TRIM_PKGTMP"
HOME_DIR="$TRIM_PKGHOME"
LOG_DIR="$DATA_DIR/logs"
LOGFILE="$LOG_DIR/install.log"
RUNTIME_DIR="$APP_DIR/runtime"

write_error() {
  local message="$1"
  if [ -n "$TRIM_TEMP_LOGFILE" ]; then
    echo "$message" > "$TRIM_TEMP_LOGFILE"
  else
    echo "$message" >&2
  fi
}

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOGFILE"
}

fail() {
  log "ERROR: $*"
  write_error "$*"
  exit 1
}

detect_arch() {
  local raw_arch="${TRIM_SYS_ARCH:-$(uname -m)}"
  case "$raw_arch" in
    x86|x86_64|amd64|linux-x64)
      echo "x64"
      ;;
    arm|arm64|aarch64|linux-arm64)
      echo "arm64"
      ;;
    *)
      fail "Unsupported system architecture: $raw_arch"
      ;;
  esac
}

sha256_file() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  else
    fail "No SHA256 tool found. Please install sha256sum or shasum."
  fi
}

verify_runtime() {
  [ -f "$APP_DIR/profile-bootstrap.mjs" ] || fail "App is missing profile-bootstrap.mjs."
  [ -x "$RUNTIME_DIR/node_modules/.bin/dsh" ] || fail "Runtime is missing executable node_modules/.bin/dsh."
  [ -f "$RUNTIME_DIR/node_modules/@deepseek-ai/dsh-web-frontend/dist/index.html" ] || fail "Runtime is missing DSH web frontend."
  [ -f "$RUNTIME_DIR/node_modules/@deepseek-ai/dsh-app-boot/lib/index.js" ] || fail "Runtime is missing DSH app boot."
  [ -f "$RUNTIME_DIR/node_modules/dshmarket/cordis.patch.yml" ] || fail "Runtime is missing bundled dshmarket."
  [ -f "$RUNTIME_DIR/node_modules/pnpm/bin/pnpm.mjs" ] || fail "Runtime is missing packaged pnpm."

  if ! node -e "require(process.argv[1])" "$RUNTIME_DIR/node_modules/node-pty" >> "$LOGFILE" 2>&1; then
    fail "Runtime node-pty module failed to load. Check $LOGFILE."
  fi

  if grep -q "fnOS patch: allow trusted-host authorities to access the Web configuration plane" "$RUNTIME_DIR/node_modules/@deepseek-ai/dsh-client-connection/lib/index.js" 2>/dev/null; then
    return 2
  fi
}

if ! command -v node >/dev/null 2>&1; then
  write_error "Node.js runtime is unavailable. Please install or enable nodejs_v24."
  exit 1
fi

if ! command -v tar >/dev/null 2>&1; then
  write_error "tar is unavailable. It is required to extract DeepSeek Harness runtime."
  exit 1
fi

mkdir -p "$LOG_DIR" "$TMP_DIR" "$HOME_DIR"
cd "$APP_DIR"

if [ -x "$RUNTIME_DIR/node_modules/.bin/dsh" ]; then
  log "Runtime already exists; verifying bundled runtime tree."
  if verify_runtime; then
    log "Existing runtime verified."
    "$(dirname "$0")/write_gateway_config"
    exit 0
  fi
  status="$?"
  if [ "$status" != "2" ]; then
    exit "$status"
  fi
  log "Existing runtime contains an old fnOS core patch; reinstalling bundled runtime tree."
  rm -rf "$RUNTIME_DIR"
else
  log "Runtime does not exist; installing bundled runtime tree."
fi

runtime_arch="$(detect_arch)"
archive="runtime-linux-${runtime_arch}.tgz"
sha_file="${archive}.sha256"
archive_path="$APP_DIR/$archive"
sha_path="$APP_DIR/$sha_file"

log "Using bundled runtime archive: $archive"

[ -f "$archive_path" ] || fail "Bundled runtime archive $archive is missing. Rebuild the full FPK."
[ -f "$sha_path" ] || fail "Bundled runtime checksum $sha_file is missing. Rebuild the full FPK."

expected_sha="$(awk '{print $1; exit}' "$sha_path" | tr 'A-F' 'a-f')"
actual_sha="$(sha256_file "$archive_path" | tr 'A-F' 'a-f')"
if [ -z "$expected_sha" ] || [ "$expected_sha" != "$actual_sha" ]; then
  fail "Runtime archive SHA256 mismatch: expected $expected_sha, got $actual_sha."
fi
log "SHA256 verified: $actual_sha"

rm -rf "$RUNTIME_DIR"
mkdir -p "$RUNTIME_DIR"
if ! tar -xzf "$archive_path" -C "$RUNTIME_DIR" >> "$LOGFILE" 2>&1; then
  rm -rf "$RUNTIME_DIR"
  fail "Failed to extract bundled runtime archive. Check $LOGFILE."
fi

verify_runtime

if [ -n "${TRIM_USERNAME:-}" ]; then
  chown -R "$TRIM_USERNAME:${TRIM_GROUPNAME:-$TRIM_USERNAME}" "$RUNTIME_DIR" >/dev/null 2>&1 || true
fi

"$(dirname "$0")/write_gateway_config"

log "Runtime installation completed."
exit 0
